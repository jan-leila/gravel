<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:name=".SlackApp"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:usesCleartextTraffic="false">
        <!-- Gravel's router API (ROUTER_API.md): exported, guarded by Gravel's signature-level permission, never defined here. -->
        <receiver
            android:name=".SlackRouter"
            android:exported="true"
            android:permission="com.anopticlabs.gravel.permission.ROUTE_NOTEBOOK_TEXT">
            <intent-filter>
                <action android:name="com.anopticlabs.gravel.notebook.action.ROUTE_TEXT" />
            </intent-filter>
            <meta-data android:name="com.anopticlabs.gravel.notebook.router.id" android:value="message" />
            <meta-data android:name="com.anopticlabs.gravel.notebook.router.params" android:value="text" />
            <meta-data android:name="com.anopticlabs.gravel.notebook.router.label" android:value="Post to Slack" />
            <meta-data android:name="com.anopticlabs.gravel.notebook.router.description" android:value="Posts what you said to a Slack channel through an incoming webhook" />
            <meta-data android:name="com.anopticlabs.gravel.notebook.router.list" android:value="${applicationId}.routers" />
        </receiver>
        <!-- The receiver's listed routers (ROUTER_API.md, Listing routers), guarded like the receiver. -->
        <provider
            android:name="com.anopticlabs.gravel.router.common.RouterListProvider"
            android:authorities="${applicationId}.routers"
            android:exported="true"
            android:permission="com.anopticlabs.gravel.permission.ROUTE_NOTEBOOK_TEXT" />
        <activity android:name=".SlackSettingsActivity" android:exported="true" android:theme="@android:style/Theme.Material.Light.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
